{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "storageAccountName": {
      "type": "string",
      "defaultValue": "csto",
      "metadata": {
        "description": "Name of the storage account. A unique string will be appended automatically."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for deployment. Defaults to resource group location."
      }
    },
    "storageAccountType": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Standard_LRS",
        "Standard_GRS",
        "Standard_ZRS"
      ],
      "metadata": {
        "description": "Storage account replication type. Standard_LRS is cheapest and works on Free Trial."
      }
    },
    "storageKind": {
      "type": "string",
      "defaultValue": "StorageV2",
      "allowedValues": [
        "StorageV2",
        "Storage",
        "BlobStorage"
      ],
      "metadata": {
        "description": "Kind of storage account. StorageV2 is recommended."
      }
    },
    "tlsVersion": {
      "type": "string",
      "defaultValue": "TLS1_2",
      "allowedValues": [
        "TLS1_0",
        "TLS1_1",
        "TLS1_2"
      ],
      "metadata": {
        "description": "Minimum TLS version. TLS1_2 is recommended for security."
      }
    }
  },
  "variables": {
    "storageName": "[toLower(concat('csto', uniqueString(resourceGroup().id)))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('storageAccountType')]"
      },
      "kind": "[parameters('storageKind')]",
      "properties": {
        "minimumTlsVersion": "[parameters('tlsVersion')]",
        "allowBlobPublicAccess": false,
        "supportsHttpsTrafficOnly": true
      },
      "tags": {
        "project": "Contoso Global Solutions",
        "environment": "Training",
        "managedBy": "CloudLabs",
        "resourceGroup": "RG-03"
      }
    }
  ],
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageName')]"
    },
    "storageAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
    },
    "primaryBlobEndpoint": {
      "type": "string",
      "value": "[reference(variables('storageName')).primaryEndpoints.blob]"
    }
  }
}
